# Copy the variables you need into your host's environment settings.
# Never commit real keys. Everything works without them in demo mode.

PORT=3000
PUBLIC_URL=https://www.your-academy.in   # used in links inside WhatsApp/email messages
COOKIE_SECURE=1                          # when served over HTTPS
TRUST_PROXY=1                            # behind Nginx / Render / Railway
ADMIN_PASSWORD=                          # first run only
NODE_ENV=production                      # hides demo one-time codes

# Razorpay (payments, receipts, UPI AutoPay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (any SMTP provider: Zoho, Google Workspace, Amazon SES, Brevo…)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Vega Sports Academy <hello@your-academy.in>"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Google reviews (Places API (New)); also set the Place ID in Admin → Settings → Trust
GOOGLE_PLACES_KEY=
